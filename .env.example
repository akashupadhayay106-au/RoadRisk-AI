# ==============================================================================
# RoadRisk AI — Environment Configuration Example (.env.example)
# Copy this file to .env and provide your local credentials as needed.
# NEVER commit .env to version control or public repositories.
#
# The application runs fully without any of these keys: missing credentials
# simply disable the corresponding optional integration (offline mode).
# ==============================================================================

# ── Application Environment ───────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── LLM provider selection (optional) ─────────────────────────────────────────
# Preferred live provider: gemini | groq | huggingface
# Leave unset to auto-select the first configured provider in that order.
LLM_PROVIDER=
# Per-request HTTP timeout (seconds) for any provider call.
LLM_TIMEOUT=20

# ── Google Gemini (optional live LLM) ─────────────────────────────────────────
# Obtain a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model ids change over time; set this to a model your key can access and use
# the in-app "Test Providers" button to confirm availability.
GEMINI_MODEL=gemini-2.0-flash

# ── Groq Cloud (optional live LLM, OpenAI-compatible) ─────────────────────────
# Obtain a key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Hugging Face Inference (optional live LLM) ────────────────────────────────
# Obtain a token from: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Advanced: override the inference endpoint template if you use a dedicated
# Inference Endpoint. "{model}" is replaced with HF_MODEL.
HF_INFERENCE_URL=https://api-inference.huggingface.co/models/{model}

# ── Weather (keyless by default) ──────────────────────────────────────────────
# Open-Meteo is public and requires NO API key, so it stays the default source.
# An unidentified third-party weather key was provided but its provider
# (WeatherAPI.com vs OpenWeatherMap) has NOT been confirmed, so it is
# intentionally not wired up yet. Do not enable it until the provider is known.
OPEN_METEO_API_URL=https://archive-api.open-meteo.com/v1/archive

# ── HeiGIT / openrouteservice (optional routing & geospatial) ─────────────────
# Obtain a key from: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key-here

# ── SQLite Database Location ──────────────────────────────────────────────────
DATABASE_PATH=data/processed/roadrisk.db
