# ============================================================================
# RoadRisk AI — Streamlit Secrets Template
# Copy this file to secrets.toml and fill in your actual keys.
# NEVER commit secrets.toml to Git.
#
# Every entry below is OPTIONAL. With no secrets configured the app runs in
# deterministic offline mode; the UI reports provider configuration state
# without ever displaying a key value.
# ============================================================================

# ── LLM provider selection (optional) ────────────────────────────────────────
# Preferred live provider: "gemini" | "groq" | "huggingface".
# Leave empty to auto-select the first configured provider in that order.
LLM_PROVIDER = ""
LLM_TIMEOUT = "20"

# ── Google Gemini (primary LLM) ──────────────────────────────────────────────
GEMINI_API_KEY = "your-gemini-api-key-here"
# Model ids change over time; confirm availability with "Test Providers".
GEMINI_MODEL = "gemini-2.0-flash"

# ── Groq (optional alternative LLM, OpenAI-compatible) ───────────────────────
GROQ_API_KEY = "your-groq-api-key-here"
GROQ_MODEL = "llama-3.3-70b-versatile"

# ── Hugging Face (optional hosted inference) ─────────────────────────────────
HF_TOKEN = "your-huggingface-token-here"
HF_MODEL = "meta-llama/Llama-3.1-8B-Instruct"
HF_INFERENCE_URL = "https://api-inference.huggingface.co/models/{model}"

# ── HeiGIT / openrouteservice (optional routing & geospatial) ────────────────
OPENROUTESERVICE_API_KEY = "your-openrouteservice-api-key-here"

# ── Weather ──────────────────────────────────────────────────────────────────
# Open-Meteo is keyless and remains the default. Do NOT add a weather API key
# here until the provider of the previously supplied key is confirmed
# (WeatherAPI.com vs OpenWeatherMap is still undetermined).
OPEN_METEO_API_URL = "https://archive-api.open-meteo.com/v1/archive"
