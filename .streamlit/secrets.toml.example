# ============================================================================
# RoadRisk AI — Secrets Template
# Copy this file to secrets.toml and fill in your actual keys.
# NEVER commit secrets.toml to Git.
# ============================================================================

# Google Gemini (primary LLM)
GEMINI_API_KEY = "your-gemini-api-key-here"

# Groq (optional alternative LLM)
GROQ_API_KEY = "your-groq-api-key-here"

# Hugging Face (optional, for hosted models)
HF_TOKEN = "your-huggingface-token-here"

# OpenWeather (optional alternative weather provider)
OPENWEATHER_API_KEY = "your-openweather-api-key-here"
